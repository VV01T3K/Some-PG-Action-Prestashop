{
  "name": "some-pg-action-prestashop",
  "type": "module",
  "private": true,
  "env": {
    "IMAGE": "vv01tek/prestAction",
    "VERSION": "0.0.1"
  },
  "scripts": {
    "dev": "echo 'WIP'",
    "all:start": "echo 'WIP'",
    "presta:up": "cd prestashop && docker-compose -f compose.dev.yaml up -d --build",
    "presta:down": "cd prestashop && docker-compose -f compose.dev.yaml down",
    "presta:del": "bun run presta:down && sudo rm -rf prestashop/src && docker volume rm prestashop_mariadb-data prestashop_caddy_data prestashop_caddy_config prestashop_valkey_data",
    "presta:restart": "bun run presta:down && bun run presta:up",
    "scrape-entrypoint-script": "docker run --rm --entrypoint /bin/sh prestashop/prestashop:1.7.8.11-fpm -c \"sed -n '1,300p' /tmp/docker_run.sh\" > 'docker_run.sh' && bat docker_run.sh"
  }
}